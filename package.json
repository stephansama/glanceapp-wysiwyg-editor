{
  "name": "glanceapp-wysiwyg",
  "private": true,
  "repository": {
    "type": "git",
    "url": "url+https://github.com/stephansama/glanceapp-wysiwig-editor.git"
  },
  "license": "MIT",
  "author": {
    "name": "Stephan Randle",
    "email": "stephanrandle.dev@gmail.com",
    "url": "https://stephansama.info"
  },
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:schema": "sh ./schema.sh",
    "check": "prettier --write . && eslint --fix",
    "dev": "vite dev --port 3000",
    "fmt:check": "prettier .",
    "fmt:write": "prettier . --write",
    "lint": "eslint",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-packagejson",
      "prettier-plugin-jsdoc",
      "prettier-plugin-tailwindcss",
      "prettier-plugin-organize-imports"
    ],
    "quoteProps": "consistent",
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
